# Raíz del monorepo: variables genéricas de integraciones BOPE.
# Command Center API (puerto 3100) usa BOPE_COMMAND_CENTER_* y JWT_SECRET.
# Plantilla completa: apps/bope-command-center-server/.env.example

GITHUB_TOKEN="__DISABLED__"
OPENAI_API_KEY="__DISABLED__"
ANTHROPIC_API_KEY="__DISABLED__"
PERPLEXITY_API_KEY="__DISABLED__"
OPENHANDS_API_KEY="__DISABLED__"
GROQ_API_KEY="__DISABLED__"
OPENWEBUI_API_KEY="__DISABLED__"
BOPE_OPENWEBUI_BASE_URL=
BOPE_OPENWEBUI_MODEL=
NEON_DATABASE_URL=
NEON_API_KEY="__DISABLED__"
NEON_PROJECT_ID=
N8N_BASE_URL=
N8N_API_KEY="__DISABLED__"
VERCEL_TOKEN="__DISABLED__"
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
BOPE_DISABLE_API=true

# Runtime local Docker / memoria operativa.
# En Docker estas rutas se resuelven dentro del contenedor.
BOPE_WORKSPACE_PATH=/workspace/bope
BOPE_OBSIDIAN_VAULT_PATH=/data/obsidian-vault
BOPE_CEREBRO_PATH=/data/cerebro
BOPE_MEMORY_INDEX_PATH=

