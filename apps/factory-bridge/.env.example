# Safe default: read-only.
FACTORY_BRIDGE_WRITE_ENABLED=false

# Existing Herdr agent names allowed through the bridge.
FACTORY_BRIDGE_AGENT_ALLOWLIST=architect,claude-glm,claude-deepseek,codex,claude,hermes-glm

# Windows paths separated with semicolon. Add only repos Sol may inspect.
FACTORY_BRIDGE_REPO_ROOTS=C:\\Users\\Santiago\\source\\repos\\Santiagoisper

# Optional absolute path. When this file exists all write tools are blocked.
FACTORY_BRIDGE_KILL_SWITCH_PATH=C:\\Users\\Santiago\\.factory-os\\KILL_SWITCH

FACTORY_BRIDGE_MAX_PROMPT_CHARS=20000
FACTORY_BRIDGE_MAX_READ_LINES=200
FACTORY_BRIDGE_COMMAND_TIMEOUT_MS=120000
# FACTORY_BRIDGE_HERDR_BIN=herdr
# FACTORY_BRIDGE_DB=C:\\Users\\Santiago\\AppData\\Local\\SantiagoFactory\\factory-bridge.db
