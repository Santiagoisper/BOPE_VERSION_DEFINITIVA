{
  "name": "@bope/command-center-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/server.js",
    "build": "pnpm exec tsc -p tsconfig.json",
    "db:migrate": "pnpm exec tsc -p tsconfig.json && node dist/scripts/migrate.js",
    "start": "node dist/server.js",
    "start:local": "node dist/server.js",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "e2e": "node e2e.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^25.3.3",
    "typescript": "~5.9.2",
    "vitest": "^2.0.0",
    "fast-check": "^3.22.0"
  }
}
