{
  "name": "@bope/command-center-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch dist/server.js",
    "build": "pnpm exec tsc -p tsconfig.json",
    "db:migrate": "pnpm exec tsc -p tsconfig.json && node --env-file=.env dist/bope-command-center-server/src/scripts/migrate.js",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^25.3.3",
    "typescript": "~5.9.2"
  }
}
