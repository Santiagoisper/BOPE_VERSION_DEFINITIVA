# BOPE es el nombre operativo del proyecto.
# La base fisica real puede llamarse distinto.
# En Neon, usar la connection string real de la base existente.
# Ejemplo validado: .../neondb?sslmode=require&channel_binding=require
BOPE_COMMAND_CENTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bope_command_center
BOPE_COMMAND_CENTER_DATABASE_SSL=false
BOPE_COMMAND_CENTER_SERVER_PORT=3100
