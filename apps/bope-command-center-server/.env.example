# ============================================================
# BOPE Command Center Server — Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# Las variables marcadas como REQUERIDAS deben estar presentes
# o el servidor fallará al arrancar con un mensaje descriptivo.
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS (REQUERIDA)
# ------------------------------------------------------------

# [REQUERIDA] Connection string de Neon (o Postgres local).
# En Neon usar la connection string real de la base existente.
# Ejemplo validado: .../neondb?sslmode=require&channel_binding=require
# En Railway tambien se acepta DATABASE_URL si la provee el plugin Postgres.
BOPE_COMMAND_CENTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bope_command_center

# Activar SSL para la conexión a Postgres.
# Usar "true" en producción con Neon. Default: false.
BOPE_COMMAND_CENTER_DATABASE_SSL=false

# ------------------------------------------------------------
# AUTENTICACIÓN (REQUERIDA)
# ------------------------------------------------------------

# [REQUERIDA] Secreto para firmar y verificar los JWTs de acceso.
# Mínimo 32 caracteres. Ejemplo: openssl rand -hex 32
# Nota: no hace falta BOPE_JWT_SECRET; si existía solo por versiones viejas, JWT_SECRET basta.
JWT_SECRET=change-me-use-a-long-random-secret-at-least-32-chars

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------

# Puerto en el que escucha el servidor HTTP. Default: 3100.
BOPE_COMMAND_CENTER_SERVER_PORT=3100

# Entorno de ejecución. "production" activa el flag Secure en
# las cookies de sesión. Valores: development | production.
NODE_ENV=development

# ------------------------------------------------------------
# PROVEEDORES LLM — API KEYS
# ------------------------------------------------------------

# API key de Anthropic. Usada como fallback cuando el CLI de
# Claude no está disponible en el momento del arranque.
# Si no se configura, solo se usará el CLI local.
ANTHROPIC_API_KEY=

# API key de OpenAI. Usada como fallback cuando el CLI de
# Codex no está disponible en el momento del arranque.
# Si no se configura, solo se usará el CLI local.
OPENAI_API_KEY=

# ------------------------------------------------------------
# CONTROL DE PROVEEDORES LLM
# ------------------------------------------------------------

# Bloquear el fallback a APIs pagas (Anthropic / OpenAI).
# "true" fuerza el uso exclusivo de CLIs locales.
# Default: false (el fallback a API está habilitado).
BOPE_DISABLE_API=true

# Preferir la API sobre el CLI aunque el CLI esté disponible.
# "true" invierte la prioridad: API primero, CLI como fallback.
# Default: false (CLI tiene prioridad sobre API).
BOPE_PREFER_API=false

# ------------------------------------------------------------
# PRESUPUESTO
# ------------------------------------------------------------

# Límite de gasto anual en USD. Default: 1500.
BOPE_ANNUAL_BUDGET=1500

# Límite de gasto mensual en USD. Default: 125.
BOPE_MONTHLY_LIMIT=125

# Límite de costo por ejecución individual en USD. Default: 2.0.
# Las ejecuciones que superen este límite serán rechazadas.
BOPE_MAX_EXECUTION_COST=2.0

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Origen CORS adicional permitido además del default (localhost:5173).
# Útil para exponer el servidor a un dominio de producción.
# Ejemplo: https://bope.example.com
BOPE_ALLOWED_ORIGIN=

# Lista adicional separada por comas. Recomendada en producción.
# Ejemplo: https://bope-command-center.vercel.app,https://bope.example.com
BOPE_ALLOWED_ORIGINS=

# SameSite de cookies. En producción cross-site Vercel -> Railway debe ser None.
# Default: Lax en development, None en production.
BOPE_COOKIE_SAME_SITE=

# ------------------------------------------------------------
# MEMORIA / OBSIDIAN
# ------------------------------------------------------------

# Rutas usadas por Docker/local para que BOPE lea doctrina, vault y archivo.
# En docker-compose se montan asi:
# - BOPE_WORKSPACE_PATH=/workspace/bope
# - BOPE_OBSIDIAN_VAULT_PATH=/data/obsidian-vault
# - BOPE_CEREBRO_PATH=/data/cerebro
BOPE_WORKSPACE_PATH=
BOPE_OBSIDIAN_VAULT_PATH=
BOPE_CEREBRO_PATH=
BOPE_MEMORY_INDEX_PATH=
